{
  "name": "@phyxiusjs/config",
  "version": "0.1.0",
  "description": "Type-safe configuration management with hot reloading, multiple sources, and observability",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "build:watch": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "clean": "rm -rf dist",
    "dev": "npm run build:watch",
    "prepublishOnly": "npm run clean && npm run build && npm run test && npm run type-check"
  },
  "keywords": [
    "config",
    "configuration",
    "environment",
    "settings",
    "phyxius",
    "typescript",
    "hot-reload",
    "watch",
    "validation",
    "env-vars",
    "yaml",
    "json"
  ],
  "author": "Phyxius Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/phyxiusjs/phyxius.git",
    "directory": "packages/utils/config"
  },
  "bugs": {
    "url": "https://github.com/phyxiusjs/phyxius/issues"
  },
  "homepage": "https://github.com/phyxiusjs/phyxius/tree/main/packages/utils/config#readme",
  "dependencies": {
    "@phyxiusjs/atom": "workspace:*",
    "@phyxiusjs/clock": "workspace:*",
    "@phyxiusjs/fp": "workspace:*",
    "@phyxiusjs/journal": "workspace:*",
    "@phyxiusjs/validate": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}