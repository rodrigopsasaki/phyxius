{
  "name": "@phyxiusjs/config",
  "version": "0.2.1",
  "type": "module",
  "description": "Type-safe configuration management with hot reloading, multiple sources, and observability",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "config",
    "configuration",
    "environment",
    "settings",
    "phyxius",
    "typescript",
    "hot-reload",
    "validation"
  ],
  "author": "Rodrigo Sasaki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigopsasaki/phyxius.git",
    "directory": "packages/utils/config"
  },
  "bugs": {
    "url": "https://github.com/rodrigopsasaki/phyxius/issues"
  },
  "homepage": "https://github.com/rodrigopsasaki/phyxius/tree/main/packages/utils/config#readme",
  "dependencies": {
    "@phyxiusjs/atom": "workspace:*",
    "@phyxiusjs/clock": "workspace:*",
    "@phyxiusjs/fp": "workspace:*",
    "@phyxiusjs/journal": "workspace:*",
    "@phyxiusjs/temporal": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "@types/node": ">=18",
    "zod": "^3.22.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
