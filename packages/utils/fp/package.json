{
  "name": "@phyxiusjs/fp",
  "version": "0.2.1",
  "description": "Functional programming primitives for exception-free, composable code",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "functional",
    "fp",
    "result",
    "either",
    "option",
    "maybe",
    "monad",
    "pattern-matching",
    "composition",
    "phyxius"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@phyxiusjs/clock": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigopsasaki/phyxius.git",
    "directory": "packages/utils/fp"
  }
}
