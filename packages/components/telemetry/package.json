{
  "name": "@phyxiusjs/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Queryable local analytics over Journal — P50/P95/P99, error rates, slowest endpoints, retry stats",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@phyxiusjs/clock": "workspace:*",
    "@phyxiusjs/handler": "workspace:*",
    "@phyxiusjs/journal": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Rodrigo Sasaki",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigopsasaki/phyxius.git",
    "directory": "packages/components/telemetry"
  },
  "keywords": [
    "telemetry",
    "analytics",
    "observability",
    "journal",
    "phyxius"
  ]
}
