{
  "name": "@phyxiusjs/handler",
  "version": "0.0.0",
  "type": "module",
  "description": "Universal work unit — a supervised Process with concurrency, backpressure, and automatic observability",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@phyxiusjs/atom": "workspace:*",
    "@phyxiusjs/clock": "workspace:*",
    "@phyxiusjs/context": "workspace:*",
    "@phyxiusjs/fp": "workspace:*",
    "@phyxiusjs/journal": "workspace:*",
    "@phyxiusjs/observe": "workspace:*",
    "@phyxiusjs/process": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Rodrigo Sasaki",
  "repository": {
    "type": "git",
    "url": "https://github.com/rodrigopsasaki/phyxius.git",
    "directory": "packages/components/handler"
  },
  "keywords": [
    "handler",
    "process",
    "concurrency",
    "backpressure",
    "supervision",
    "phyxius"
  ]
}
