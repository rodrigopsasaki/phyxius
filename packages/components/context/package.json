{
  "name": "@phyxiusjs/context",
  "version": "0.2.0",
  "type": "module",
  "description": "Pure AsyncLocalStorage primitive for typed thread-local data",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@types/node": ">=18"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.7",
    "@vitest/coverage-v8": "^2.1.8",
    "size-limit": "^11.1.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Rodrigo Sasaki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigopsasaki/phyxius.git",
    "directory": "packages/components/context"
  },
  "keywords": [
    "context",
    "async-local-storage",
    "typed-context",
    "thread-local",
    "async-context",
    "phyxius"
  ]
}
