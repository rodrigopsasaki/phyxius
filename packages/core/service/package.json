{
  "name": "@phyxiusjs/service",
  "version": "0.1.0",
  "type": "module",
  "description": "Service function definitions with required failure policies",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "dependencies": {
    "@phyxiusjs/clock": "workspace:*",
    "@phyxiusjs/fp": "workspace:*",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.7",
    "@vitest/coverage-v8": "^2.1.8",
    "size-limit": "^11.1.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "15 KB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Rodrigo Sasaki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigopsasaki/phyxius.git",
    "directory": "packages/core/service"
  },
  "keywords": [
    "service",
    "function",
    "policy",
    "retry",
    "timeout",
    "circuit-breaker",
    "phyxius"
  ]
}
