{
  "name": "@phyxiusjs/runtime",
  "version": "0.1.0",
  "description": "Runtime execution environment for Phyxius service functions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phyxiusjs/clock": "workspace:*",
    "@phyxiusjs/fp": "workspace:*",
    "@phyxiusjs/service": "workspace:*",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
